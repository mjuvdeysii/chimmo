        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drops from 5 to 1 and climbs five tidy scale steps with crisp triple-time symmetry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 跳下 1 后一口气沿楼梯走到 5，跳两下 1 点地，再迈向高音 1↑——节奏明快对称。"
          }
        }
      }
    },
    "spec_bach_minuet_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BWV Anh. 114 (1725 PD) · Crisp triple-meter step"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BWV Anh.114 1725 公版 · 轻快三拍子舞步"
          }
        }
      }
    },
