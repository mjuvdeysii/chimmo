        }
      }
    },
    "spec_liebestraum_insight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens with an ascending sixth leap from low 5 up to 3, gently lingering before exhaling gracefully back to 1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开头从低处 5↓ 一跃大跳六度到 3·拍咯，反复轻唤同一颗音后，轻轻叹息落回 1·陶诺，像在夜风里倾诉心事。"
          }
        }
      }
    },
    "spec_liebestraum_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Franz Liszt (1850 PD) · Expressive sixth leap and warm sigh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "李斯特《爱之梦》No.3 1850 公版 · 六度深情仰望"
          }
        }
      }
    },
    "spec_liebestraum_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liszt: Liebestraum No. 3"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "爱之梦 · 李斯特"
          }
        }
      }
    },
    "spec_mozart_twinkle_cat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baroque & Classical"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "巴赫与古典公版"
          }
        }
      }
    },
    "spec_mozart_twinkle_insight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the horizon with a clean fifth leap (1 to 5), peeks up to 6, and walks calmly down the steps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1→5 纯五度瞬间打开视野，6 往上一探立刻回 5，再沿 4-3-2-1 一步步走回家。"
          }
        }
      }
    },
    "spec_mozart_twinkle_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "W. A. Mozart K.265 (1781 PD) · Pure fifth leap and stepwise return"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "莫扎特 K.265 1781 公版 · 五度大跳与级进回家"
          }
        }
      }
    },
    "spec_mozart_twinkle_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mozart: Ah! vous dirai-je Variations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小星星引力 · 莫扎特"
          }
        }
      }
    },
