    "spec_beethoven_moonlight_insight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds a quiet repeated 5 while dark minor water currents shift subtly underneath."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上方旋律几乎只在同一颗 5 上低声重复，靠底下悄悄滑动的小调水波推动情绪前进。"
          }
        }
      }
    },
    "spec_beethoven_moonlight_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ludwig van Beethoven (1801 PD) · Nocturnal minor stillness"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贝多芬 Op.27 No.2 1801 公版 · 深邃小调独白"
          }
        }
      }
    },
