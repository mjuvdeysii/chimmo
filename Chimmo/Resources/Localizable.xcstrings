      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glides along a weightless 6-3-2-1 pentatonic arc bathed in pale golden morning light."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 6→3→2→1 的五声柔和弧线起步，清澈得像阳光照在金色麦田上。"
          }
        }
      }
    },
    "spec_debussy_flaxen_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Debussy (1910 PD) · Pentatonic morning sun"
          }
        },
        "zh-Hans": {
          "stringUnit": {
