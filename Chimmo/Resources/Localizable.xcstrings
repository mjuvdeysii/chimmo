      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmeasured moonlight drifts softly down from 1-up and 6 into silver ripples of 5 and 3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高处的 1↑ 与 6 缓步滑落到 5 与 3，像月光透过云层一层层融在水里。"
          }
        }
      }
    },
