            "value": "原创声学舒缓集"
          }
        }
      }
    },
    "spec_orig_bittersweet_insight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walks through sunny major cadences yet closes tenderly on relative minor 6 for lingering warmth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
