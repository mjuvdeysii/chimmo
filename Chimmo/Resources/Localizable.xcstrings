      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfolds triad pillars one pure stone at a time (1-3-5-1-up) so harmonic gravity feels visible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把和弦里的音一颗颗拆开往上爬（1-3-5-1↑），像晶莹的水晶楼梯。"
          }
        }
      }
    },
    "spec_bach_prelude_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
