    "spec_beethoven_elise_insight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rocking half-step neighbors above resolve gently into broken minor triads rising from below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高处两颗相邻音珠轻轻往复摇摆制造悬念，再由分解三和弦自下而上托起归主。"
          }
        }
      }
    },
    "spec_beethoven_elise_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ludwig van Beethoven (1810 PD) · Delicate minor sway"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贝多芬 WoO 59 1810 公版 · 灵巧摇摆与分解托起"
          }
        }
      }
    },
    "spec_beethoven_elise_title": {
