      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweeps from sustained 5 through a rising minor scale arc, shaping a deeply lyrical evening silhouette."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用微酸小调 5→1-2-3-4-5 勾勒出月夜下的宿命感，大提琴线条绵长深沉。"
          }
