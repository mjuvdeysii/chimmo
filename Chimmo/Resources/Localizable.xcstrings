    "spec_swan_insight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arpeggiated ripples carry the solo cello as it glides softly from 1-up through 7 and 3 before rising cleanly toward home."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左手用细腻的水波琵音铺开镜面湖水，大提琴先从高处 1↑→7→3 滑入湖心，再从 4→5→6 缓缓扬起飞向高音 1↑。"
          }
        }
      }
    },
    "spec_swan_lake_cat": {
      "extractionState": "manual",
      "localizations": {
