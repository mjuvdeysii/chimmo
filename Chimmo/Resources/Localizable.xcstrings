    },
    "legal_l_b1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 44-voice chamber synthesis & binaural DSP engine (FeltPianoSynth), pure Swift / Accelerate vDSP pitch tracking, and all ceramic vector artwork are built with zero third-party binaries."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 内 44 声部室内乐与双耳波合成引擎（FeltPianoSynth）、纯 Swift / Accelerate vDSP 音高检测模块以及所有视觉绘制均为自研零外部二进制依赖实现。"
          }
        }
      }
    },
    "legal_l_b2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Classical capsules and specimens draw from verified Public Domain works arranged with custom multi-voice chamber textures; modern studies are 100% original. All license and source notices are bundled offline in the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声库中的古典战栗胶囊全部取材于已进入国际公版领域（Public Domain）的传世作品，并在其之上加入自研多声部室内乐伴奏织体；现代夏日及星尘示范曲目为本作品 100% 原创。全部许可与公版参考清单已完整内置本机离线展示。"
          }
        }
      }
    },
    "legal_l_h1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Offline Audio Synthesis & Pitch DSP"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一、离线音频引擎与基频计算"
          }
        }
      }
    },
    "legal_l_h2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Public Domain Scores & Original Works"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二、公版古典乐谱与原创示范集"
          }
        }
      }
    },
    "legal_licenses_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public-domain scores & custom Swift DSP"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公版古典名作与自研音频数学"
          }
        }
      }
    },
    "legal_licenses_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scores & Credits"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公版谱源与致谢"
          }
        }
      }
    },
    "legal_p_b1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mie & Mou operates strictly offline: zero analytics SDKs, zero ads, zero crash telemetry, zero accounts, and zero outbound network requests. All settings stay inside local device storage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「咩哞 · Mie & Mou」运行于完全本地离线架构：不集成任何第三方统计、广告、崩溃追踪 SDK，不包含账户体系或服务器同步，您的所有设置与声场参数只保存在本机系统存储中。"
          }
        }
      }
    },
    "legal_p_b2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Microphone access is used strictly on-demand inside Hum Pitch Match to compute your vocal fundamental (Hz) in RAM—never saved or uploaded.\n2. Photos Add-Only access is requested solely when you tap Save to Photos to export a static PNG card.\n3. Only CA92.1 (UserDefaults) and 35F9.1 (SystemBootTime) Required Reason APIs are declared in PrivacyInfo.xcprivacy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 麦克风仅在您主动开启「轻哼找同频」时临时采样计算基频（Hz），纯内存瞬时处理后即刻释放，从不落盘、从不上传。\n2. 相册添加权限仅在您主动点击「存入相册」时将生成的静态 PNG 卡片写入相册，绝不读取既有照片。\n3. 本机仅声明 Apple Privacy Manifest 所需的 CA92.1（用户偏好）与 35F9.1（系统运行时间片统计）两项必要 API。"
          }
        }
      }
    },
    "legal_p_b3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can revoke permissions in iOS Settings, reset local statistics in Atelier, or delete the app at any time with zero external trace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以随时关闭系统权限、重置本地统计偏好或直接卸载应用，本应用在云端或外部均不留存任何痕迹。"
          }
        }
      }
    },
    "legal_p_h1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 100% Offline, Zero Network Traffic"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一、100% 本地离线，无网络请求"
          }
        }
      }
    },
    "legal_p_h2": {
