    "band_desc_alpha": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unforced sunlit rhythm that unwinds tight pacing while keeping thoughts clear."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "松弛平顺的日光松弛节律，在保持头脑清醒的同时卸下紧绷节奏。"
          }
        }
      }
    },
    "band_desc_delta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep unhurried low-frequency swell paired with warm brown rain for settling into rest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "极缓沉稳的深空脉冲，配合厚重棕红底噪，像在棉布夜色里慢慢落定。"
          }
        }
      }
    },
    "band_desc_gamma": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crisp 40 Hz high-band shimmer paired with sea-salt mist texture for steady clarity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "40 Hz 明澈高频稳态微振，配合海盐微光颗粒感，唤醒清晰专注力。"
          }
        }
      }
    },
    "band_desc_theta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft cradling drift blended with warm ceramic fifth overtones for twilight unwinding."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温软漂浮的摇篮摆频，搭配手工陶窑泛音，适合放空与入睡前过渡。"
          }
        }
      }
    },
