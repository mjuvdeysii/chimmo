    "spec_chopin_nocturne_insight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A steady bass anchor and two lilting chord steps buoy the long major-sixth singing leap overhead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆舞呼吸左手伴奏：一拍沉稳低音，两拍轻柔上浮，托着右手 5↓→3 的大六度优雅起飞。"
          }
        }
      }
    },
    "spec_chopin_nocturne_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frederic Chopin (1832 PD) · Lyrical waltz twilight"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肖邦 Op.9 No.2 1832 公版 · 浪漫派圆舞夜色"
          }
        }
      }
    },
