          }
        }
      }
    },
    "legal_privacy_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "100% Offline · Zero Tracking · No Account"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "100% 本地离线 · 零追踪 · 无账户"
          }
        }
      }
    },
    "legal_privacy_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy & Security"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私与安全声明"
          }
        }
      }
    },
    "legal_t_b1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mie & Mou is an offline sensory sound-art and quiet companionship tool. It is NOT a medical device or clinical software and does not diagnose, treat, cure, or prevent insomnia, neurological conditions, tinnitus, or any health disorder. Consult a qualified physician for medical care."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「咩哞 · Mie & Mou」是专注聆听放松、规律呼吸陪伴与和声体验的离线声学艺术工具，不属于医疗器械或临床诊疗软件，不用于诊断、治疗、治愈或预防任何身体或心理疾病（含失眠障碍、神经系统疾病、耳鸣治疗或注意缺陷等）。如有健康困扰请及时咨询专业执业医师。"
          }
        }
      }
    },
    "legal_t_b2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may freely save and share generated static PNG postcards personally; do not represent any audio or card output as medical therapy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可自由导出保存本地生成的静态共鸣 PNG 卡片并与亲友分享，请勿将本应用曲目或声音生成物用于误导性医疗疗效宣传。"
          }
        }
      }
    },
    "legal_t_b3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Binaural beats and isochronic pulses are crafted strictly for sensory ambiance at comfortable volumes. If you have epilepsy, pulse sensitivity, active tinnitus, or a hearing implant, enable Pure Ambient Wash (No Pulse) in the wash drawer or consult a physician before using 40 Hz tones. Never use sleep or Night Lamp modes while driving or operating machinery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双耳差频与等时脉动声场仅为艺术氛围营造，请佩戴舒适音量收听。若您存在癫痫病史、规律声光脉冲敏感、耳鸣发作或佩戴植入式助听装置，请优先在声床抽屉中启用无脉冲的「纯自然声床（零声波脉冲）」或咨询医师后再决定是否使用 40 Hz 频段；驾驶与机械作业时切勿开启睡前静息或夜灯模式。"
          }
        }
      }
    },
    "legal_t_h1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Non-Medical Sensory Art Boundary"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一、非医疗健康与声学边界"
          }
        }
      }
    },
