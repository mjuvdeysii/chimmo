    "hum_sheet_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hum softly for 2-3 seconds; fundamental analysis runs strictly offline in memory to tune your carrier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻轻哼 2–3 秒任意舒缓单音，本机离线采集基频后将合成器载波调谐至你的自然共鸣音高。"
          }
        }
      }
    },
