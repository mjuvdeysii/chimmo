          "stringUnit": {
            "state": "translated",
            "value": "Hum slightly longer so the detector can lock a steady pitch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再轻轻多哼一小会儿，我就能锁住你的频率"
          }
