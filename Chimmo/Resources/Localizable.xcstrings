    },
    "spec_dvorak_home_insight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rests purely on 1-2-3-5, skipping half-step tension to bathe the melody in warm dusk nostalgia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全曲只用 1-2-3-5 四颗核心音高，避开紧绷的 4 和 7，写出辽阔温暖的田野夜色。"
          }
        }
      }
    },
    "spec_dvorak_home_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Antonin Dvorak (1893 PD) · Warm pentatonic horizon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "《自新大陆》第二乐章 1893 公版 · 柔和五声音阶"
          }
        }
      }
    },
