      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle 5-6-5 triplet turn lifts upward to high 1, voicing a quiet twilight greeting beneath the window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三个快音轻轻一转再向上仰起（5-6-5→1↑），像在夜色窗下欲言又止的轻声问候。"
          }
        }
      }
    },
