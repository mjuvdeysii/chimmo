    "spec_campanella_insight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bright celesta leaps strike a crystal bell motif in minor mode while an inner line threads delicately beneath."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小调里的钟声跳跃：高处的 5·壳咯像清脆银铃反复敲响，另一条声音在下面灵巧穿梭。"
          }
        }
      }
    },
    "spec_campanella_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Franz Liszt (1851 PD) · Sparkling celesta bell motif"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "李斯特《帕格尼尼练习曲·钟》1851 公版 · 灵动铃音"
          }
        }
      }
    },
    "spec_campanella_title": {
