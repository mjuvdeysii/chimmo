      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half of the music lives in negative space, letting sparse 3/4 waltz chords breathe around long chimes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好的编曲一半是留白：每颗音珠拖出绵长余影，让圆舞和弦在空隙里安静呼吸。"
          }
        }
      }
    },
