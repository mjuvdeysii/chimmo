    "safety_body_boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delta, Theta, Alpha, and Gamma soundscapes, hum tuning, and sleep fade timers provide offline acoustic art and calming ambiance only—never medical diagnosis, clinical intervention, or therapy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "咩哞提供的 Delta / Theta / Alpha / Gamma 声场、轻哼定频共振与睡眠渐弱定时均属于纯粹离线感官艺术与放松陪伴体验，不构成医疗诊断、康复介入或疾病治疗手段。"
          }
        }
      }
    },
    "safety_body_caution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. If you experience epilepsy, active tinnitus, pulse sensitivity, or wear a hearing implant, enable Pure Ambient Wash (No Pulse) inside the Wash Drawer or consult a clinician before listening to 40 Hz Gamma.\n2. Do not use deep-rest Delta/Theta beds or Night Lamp mode while driving or operating machinery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 若您对规律脉冲声响、光声节律变化敏感，或存在癫痫病史、耳鸣发作期或植入式助听装置，请优先在声床抽屉里开启无脉冲的「纯自然声床（零声波脉冲）」，或遵照医嘱再决定是否收听 40 Hz 频段。\n2. 驾驶、高空作业或需要高度警觉操作机械期间，请勿使用深睡（Delta / Theta）睡前静息及闭眼夜灯模式。"
          }
        }
      }
    },
    "safety_body_headphones": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stereo wired or A2DP Bluetooth headphones deliver true L/R binaural differentials; built-in speakers switch automatically to comfortable low-distortion isochronic amplitude pulses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "佩戴立体声有线/蓝牙耳机时，左右耳分别呈现差频双声波；使用手机扬声器外放时，系统自动切换为低失真柔和等时包络脉冲，确保随时保持清晰听感与舒适温和音量。"
          }
        }
      }
    },
