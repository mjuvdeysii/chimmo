    "spec_consolation3_insight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sings unhurriedly across 5-3-2-1 over luminous broken chords, giving every sustained tone quiet warmth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在 5-3-2-1 之间像轻抚琴键般歌唱，底下的水波琵音让每个长音都泛着柔和微光。"
          }
        }
      }
    },
    "spec_consolation3_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Franz Liszt (1850 PD) · Cantabile nocturne arc"
