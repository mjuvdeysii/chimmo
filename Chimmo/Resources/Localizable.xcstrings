    "spec_bach_air_insight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anchors time with a long serene 3 before cascading gently down 4-2-7-low-1 over shifting harmonies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开头用一颗极长的 3·拍咯定住时光，随后 4-2-7↓-1 像丝绸般蜿蜒落下。"
          }
        }
      }
    },
