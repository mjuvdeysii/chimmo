    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mie & Mou listens to your hum strictly on this iPhone to tune a personalized sympathetic sound resonance. Audio is never uploaded or sent over the network."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咩哞只在本机离线捕捉轻哼基频，用于生成与你声音同频的声波共振；所有声音从不上传、不联网。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mie & Mou only saves your generated static PNG resonance card to Photos when you tap Save; it never reads or scans your existing photos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咩哞仅在您主动轻点保存共鸣卡时，将生成的静态 PNG 卡片图片写入手机相册；不会读取或扫描您的任何既有照片。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
