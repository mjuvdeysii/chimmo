        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咩哞只在本机离线捕捉轻哼基频，用于生成与你声音同频的声波共振；所有声音从不上传、不联网。"
          }
        }
      }
